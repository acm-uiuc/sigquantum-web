---
// import "@fontsource/fira-sans";
import { ViewTransitions } from 'astro:transitions';
import { SITE } from "@src/config.ts";
import "@src/styles/global.css";

export type Props = {
  title: string;
  description: string;
};

const { title = SITE.title, description } = Astro.props;
---

<!-- <html data-theme="night" lang="en"> ??? consider using daisyui theme -->
<!-- Use Google Fonts, if you don't wanna prefer a self-hosted version --><!-- <link rel="preconnect" href="https://fonts.googleapis.com">
    <!-- <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin> -->
    <!-- <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500;600;700&display=swap" rel="stylesheet"> -\-> -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{title}</title>
<meta name="title" content={title} />
{description && <meta name="description" content={description} />}
<!-- <ViewTransitions /> !! doesn't work with nix -->

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
