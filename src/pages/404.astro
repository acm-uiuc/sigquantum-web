---
import DefaultPageLayout from '@layouts/Default.astro';
import { randomXkcd } from '@src/utils';

const title = '404';
const description = 'Page not found';
const xkcd = randomXkcd();
---

<DefaultPageLayout content={{ title, description }}>
  The page you tried to access isn't a valid basis state; better call a quantum mechanic.

  <div class="flex">
    <div class="m-auto p-20">
      <a href={xkcd.href}>
        <img class="justify-center" src={xkcd.src} alt={"XKCD: " + xkcd.name} />
      </a>
    </div>
  </div>

</DefaultPageLayout>
